# Copy to .env and fill in. Never commit .env.
TAG=latest
DOMAIN=chat.sourceeasy.in
FRONTEND_URL=https://chat.sourceeasy.in
# rake secret / openssl rand -hex 64
SECRET_KEY_BASE=replace-with-random-secret
# Internal-only: disable public signup
ENABLE_ACCOUNT_SIGNUP=false
POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=change-me-strong-password
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379
RAILS_LOG_TO_STDOUT=true
ACTIVE_STORAGE_SERVICE=local
MAILER_SENDER_EMAIL=Source Easy <noreply@sourceeasy.in>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Webhook back to server 1 (optional)
SOURCE_EASY_WEBHOOK_URL=https://sourceeasy.in/webhooks/chatwoot
