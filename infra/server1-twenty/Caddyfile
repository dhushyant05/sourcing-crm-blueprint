# Only the Source Easy server is public; Postgres and Redis stay on the internal docker network.
{$DOMAIN} {
	# Real-time notifications (SSE): no compression, flush every write, keep the stream open for hours.
	@sse path /api/notifications/stream
	handle @sse {
		reverse_proxy api:8080 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
				keepalive 2h
			}
		}
	}
	@compress not path /api/notifications/stream
	encode @compress gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	# Lead photos/videos: 100 MB per video, up to 10 files per request (the API enforces the exact limits).
	request_body {
		max_size 1100MB
	}
	reverse_proxy api:8080 {
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}
}
