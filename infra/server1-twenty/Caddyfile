# Only the Source Easy server is public. Twenty stays on the internal docker network.
{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	# Lead photos/videos: 100 MB per video, up to 10 files per request (the API enforces the exact limits).
	request_body {
		max_size 1100MB
	}
	reverse_proxy api:8080 {
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}
}
