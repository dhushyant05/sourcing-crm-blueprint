# Copy to .env and fill in. Never commit .env.
TAG=latest
DOMAIN=sourceec.in
# Twenty is internal-only; its own URL is the localhost tunnel address.
SERVER_URL=http://localhost:3000
PG_DATABASE_USER=twenty
PG_DATABASE_PASSWORD=change-me-strong-password
# openssl rand -base64 32
APP_SECRET=replace-with-random-secret
# Chatwoot webhook target (server 2) — coupling is webhook URLs only
CHATWOOT_BASE_URL=https://chat.sourceec.in

# ---- Source Easy server (server/) ----
# Twenty > Settings > APIs & Webhooks > create API key (via SSH tunnel to localhost:3000)
TWENTY_API_KEY=
# openssl rand -base64 48  (min 32 chars)
JWT_SECRET=
JWT_TTL=12h
# Created on first boot if missing; change the password after first login
SUPER_ADMIN_EMAIL=admin@sourceec.in
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
# Shown to SUPER_ADMIN only, JSON: [{"label":"Nightly dumps","url":"https://..."}]
BACKUP_LINKS=[]
