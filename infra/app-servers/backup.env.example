# /etc/source-easy/backup.env on server 1 (Twenty)
APP_NAME=twenty
COMPOSE_DIR=/opt/source-easy/infra/server1-twenty
DB_SERVICE=db
DB_NAME=default
DB_USER=twenty
STORAGE_HOST=backup@storage.sourceeasy.in
STORAGE_DIR=/srv/backups
SSH_KEY=/root/.ssh/id_ed25519_backup
# On server 2 (Chatwoot) use:
# APP_NAME=chatwoot
# COMPOSE_DIR=/opt/source-easy/infra/server2-chatwoot
# DB_SERVICE=postgres
# DB_NAME=chatwoot
# DB_USER=chatwoot
